# Copy to .env for local dev. Bun auto-loads .env (no dotenv).
NODE_ENV=development
PORT=8790
HOST=0.0.0.0

# Local dev Postgres (docker compose up -d db)
DATABASE_URL=postgresql://commonpractice:commonpractice@localhost:5433/commonpractice

# The DIRECT (non-pooler) DSN for the single pinned connector LISTEN session. UNSET = falls back to
# DATABASE_URL, which is exactly right anywhere there is no pooler (local dev, CI's ephemeral
# postgres) — leave it commented out here. In prod DATABASE_URL is the SESSION POOLER, and a LISTEN
# session on it burns one of pgbouncer's shared pool_size slots AND gets killed every 10 minutes by
# the server's idle_session_timeout, silently losing every NOTIFY in the reconnect gap.
#
# ⚠️ The fallback is only SAFE because DATABASE_URL is the SESSION pooler. LISTEN and
# `SET idle_session_timeout` are both session state, and under a TRANSACTION pooler a server
# connection belongs to a client only for one transaction — so the registration would land on
# whichever backend happened to be free and the NOTIFYs would arrive on a connection nobody is
# holding. Never point this (or DATABASE_URL) at pgbouncer's transaction-mode port.
# LISTEN_DATABASE_URL=postgresql://cp_app:...@postgres.example.com:5432/commonpractice

# Dev auth: skip Keycloak entirely, synthesize a platform+employee user.
# Must pair with frontend VITE_AUTH_BYPASS=true.
AUTH_BYPASS=true

# Keycloak (placeholders for Session 0 — no live client provisioned yet).
# Real realm/client verified live + created in a later session.
#
# WARNING: this default points a DEV box at LIVE PRODUCTION auth. The admin client refuses to
# send an empty credential (src/services/keycloak-admin.ts::getAdminToken), so leaving
# KEYCLOAK_USER_REALM_ADMIN_CLIENT_SECRET unset is safe. If you are setting up dev, point KEYCLOAK_URL at a
# local Keycloak or leave AUTH_BYPASS=true and never exercise the invite routes.
KEYCLOAK_URL=https://auth.nonagentic.ai
KEYCLOAK_REALM=portal
KEYCLOAK_CLIENT_ID=commonpractice-backend
KEYCLOAK_ISSUER=https://auth.nonagentic.ai/realms/portal
# Realm-per-app: CP's USERS live in their own realm (prod: commonpractice). Defaults to KEYCLOAK_REALM.
# Admin client: confidential service account IN that realm (client_credentials; prod-required):
# KEYCLOAK_USER_REALM=commonpractice
# KEYCLOAK_USER_REALM_ADMIN_CLIENT_ID=commonpractice-admin
# KEYCLOAK_USER_REALM_ADMIN_CLIENT_SECRET=

# CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5174

# Early-access self-signup (docs/runbooks/early-access-signup.md). All optional; each is off/dark
# when unset.
# Server-to-server intake (POST /api/signup-approvals/intake): allowed Keycloak client ids (azp)
# and the realm role their service account must hold.
# CP_SIGNUP_INTAKE_AZP=cp-signup-intake
# CP_SIGNUP_INTAKE_ROLE=cp-signup-intake
# Cloudflare Turnstile. Secret set → a sent token is verified; REQUIRED=true → anonymous
# notify-self must carry one (REQUIRED without SECRET refuses anonymous signups, 503).
# TURNSTILE_SECRET=
# TURNSTILE_REQUIRED=false
# Telegram signup notifications — sendMessage only, never setWebhook/getUpdates. Disabled unless
# all three are set. THREAD_ID is the "CP signups" forum topic, NOT 167 (external-probe alarms).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SIGNUP_CHAT_ID=-1003934173351
# TELEGRAM_SIGNUP_THREAD_ID=
# Untrusted signups (anonymous notify-self without a passed Turnstile check) are not announced one
# by one; at most one digest message per this many hours says how many wait. 0 = no digest.
# SIGNUP_DIGEST_INTERVAL_HOURS=6
# Public origin used in the Approve/Reject deep links (defaults to the first CORS origin).
# CP_PUBLIC_URL=https://commonpractice-app.nonagentic.ai
