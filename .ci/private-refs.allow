backend/tests/storage\-writer\.test\.ts:\.svc\.cluster\.local
frontend/src/lib/llm/adapter\-identity\.backend\-contract\.test\.ts:\.svc\.cluster\.local
frontend/src/routes/\(tenant\)/llm\-settings/llm\-settings\.key\-vendor\.render\.test\.ts:\.svc\.cluster\.local
scripts/ci/no\-private\-refs\.sh:\.svc\.cluster\.local
