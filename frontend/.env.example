# Copy to .env for local dev.
# Dev auth bypass — skip Keycloak, synthesize a dev user. Pair with backend
# AUTH_BYPASS=true. Gated on import.meta.env.DEV so it can't leak to prod builds.
VITE_AUTH_BYPASS=true

# Keycloak (placeholders for Session 0 — no live client provisioned yet).
VITE_KEYCLOAK_URL=https://auth.nonagentic.ai
VITE_KEYCLOAK_REALM=commonpractice
VITE_KEYCLOAK_CLIENT_ID=commonpractice-frontend

# Prod-only: where server.js proxies /api/* (in-cluster backend service URL).
# CP_BACKEND_URL=http://commonpractice-backend:8790
